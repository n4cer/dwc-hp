# Routes
# This file defines all application routes (Higher priority routes first)
# ~~~~

# An example controller showing a sample home page
GET     /                           controllers.HomeController.index
GET     /robots.txt                controllers.HomeController.robots
GET     /sitemap.xml               controllers.HomeController.sitemap
GET     /news                       controllers.HomeController.news(request: Request, page: Int ?= 1)
GET     /clanwars                   controllers.HomeController.clanwars
GET     /clanwar/:id                controllers.HomeController.clanwar(request: Request, id: Long)
GET     /history                    controllers.HomeController.history
GET     /lineup                     controllers.HomeController.lineup
GET     /player/:id                 controllers.HomeController.player(id: Long)
GET     /contact                    controllers.HomeController.contact
GET     /imprint                    controllers.HomeController.imprint()
GET     /privacy                    controllers.HomeController.privacy()
GET     /todo                       controllers.HomeController.todo
GET     /random                     controllers.HomeController.randomPic
GET     /q3pickup                   controllers.HomeController.pickup

# Administration
GET     /admin/login                controllers.AdminController.login(request: Request)
POST    /admin/login                controllers.AdminController.authenticate(request: Request)
POST    /admin/logout               controllers.AdminController.logout(request: Request)
GET     /admin                      controllers.AdminController.index(request: Request)
GET     /admin/news                 controllers.AdminController.newsIndex(request: Request)
GET     /admin/news/new             controllers.AdminController.newNews(request: Request)
GET     /admin/news/:id/edit        controllers.AdminController.editNews(request: Request, id: Long)
POST    /admin/news                 controllers.AdminController.createNews(request: Request)
POST    /admin/news/:id             controllers.AdminController.updateNews(request: Request, id: Long)
GET     /admin/clanwars             controllers.AdminController.clanwarIndex(request: Request)
GET     /admin/clanwars/new         controllers.AdminController.newClanwar(request: Request)
GET     /admin/clanwars/:id/edit    controllers.AdminController.editClanwar(request: Request, id: Long)
POST    /admin/clanwars             controllers.AdminController.createClanwar(request: Request)
POST    /admin/clanwars/:id         controllers.AdminController.updateClanwar(request: Request, id: Long)
GET     /admin/lineup                controllers.AdminController.lineupIndex(request: Request)
GET     /admin/lineup/new            controllers.AdminController.newLineupMember(request: Request)
GET     /admin/lineup/:id/edit       controllers.AdminController.editLineupMember(request: Request, id: Long)
POST    /admin/lineup                controllers.AdminController.createLineupMember(request: Request)
POST    /admin/lineup/:id            controllers.AdminController.updateLineupMember(request: Request, id: Long)
GET     /admin/squads                controllers.AdminController.squadIndex(request: Request)
GET     /admin/squads/new            controllers.AdminController.newSquad(request: Request)
GET     /admin/squads/:id/edit       controllers.AdminController.editSquad(request: Request, id: Long)
POST    /admin/squads                controllers.AdminController.createSquad(request: Request)
POST    /admin/squads/:id            controllers.AdminController.updateSquad(request: Request, id: Long)

# Map static resources from the /public folder to the /assets URL path
GET     /assets/*file               controllers.Assets.versioned(path="/public", file: Asset)
