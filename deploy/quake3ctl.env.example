QUAKE3CTL_TOKEN=replace-with-a-long-random-value
QUAKE3CTL_PORT=8765
# Files uploaded over SFTP wait here until installed from /admin/uploads.
QUAKE3CTL_UPLOAD_DIR=/srv/upload/eingang
# Install targets: <pk3 dir>/baseq3, <pk3 dir>/osp and the download folder.
# The pk3 dir must also be in ReadWritePaths of quake3ctl.service.
QUAKE3CTL_PK3_DIR=/home/micha/docker/q3-osp-server/server-data
QUAKE3CTL_DOWNLOAD_DIR=/var/lib/dwc/downloads
