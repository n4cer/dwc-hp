[Unit]
Description=Quake 3 control sidecar (systemctl proxy for the dwc admin panel)
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/sbin/quake3ctl.py
EnvironmentFile=/etc/dwc/quake3ctl.env
Restart=on-failure
RestartSec=5
# Runs as root: it only ever calls "systemctl start/stop/is-active" on the
# three hardcoded quake3@*.service units below, never a shell or user input.
NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
