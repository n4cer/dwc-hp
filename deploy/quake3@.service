[Unit]
Description=Quake 3 %i server (docker compose)
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Adjust to wherever the existing quake3-docker-compose project keeps this
# stack's docker-compose.yml (one subfolder per game type: duel/tdm/ctf).
WorkingDirectory=/opt/quake3/%i
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=120
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
