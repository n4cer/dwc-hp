[Unit]
Description=Quake 3 %i server (docker compose)
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
# All three game types are services in one docker-compose.yml, so start/stop
# target just the one service (q3server-%i) instead of the whole project.
WorkingDirectory=/home/micha/docker/q3-osp-server
ExecStart=/usr/bin/docker compose up -d q3server-%i
ExecStop=/usr/bin/docker compose stop q3server-%i
TimeoutStartSec=120
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
