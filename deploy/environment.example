PLAY_HTTP_SECRET_KEY=replace-with-a-long-random-value
DWC_DB_URL=jdbc:postgresql://127.0.0.1:5432/dwc
DWC_DB_USERNAME=dwc
DWC_DB_PASSWORD=replace-me
DWC_ADMIN_USERNAME=admin
DWC_ADMIN_PASSWORD=replace-me-too
# Must equal QUAKE3CTL_TOKEN in quake3ctl.env
DWC_QUAKE3_TOKEN=replace-with-a-long-random-value
# Public address shown in the site sidebar; leave unset to hide it entirely.
DWC_QUAKE3_PUBLIC_HOST=quake.doomwarriors.de
DWC_QUAKE3_DUEL_PORT=27960
DWC_QUAKE3_TDM_PORT=27961
DWC_QUAKE3_CTF_PORT=27962
